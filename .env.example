# Copy to .env for local runs. On Hugging Face Spaces / Render, add these as secrets / environment variables.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional backups: each Google account gets its own free daily quota. When one key's
# daily quota runs out, HireLens moves to the next key by itself.
# GEMINI_API_KEY_2=teammate-key
# GEMINI_API_KEY_3=another-teammate-key
# HIRELENS_FALLBACK_MODELS=some-flash-lite-model   # tried on every key after the main model is used up

# Optional: use Groq instead (free key at https://console.groq.com/keys)
# HIRELENS_PROVIDER=groq
# GROQ_API_KEY=your-key-here

# Optional overrides
# HIRELENS_MODEL=gemini-3.8-flash
# HIRELENS_MODEL_CRITIC=some-stronger-model   # per-agent model override
# HIRELENS_MIN_CALL_INTERVAL=4                # seconds between calls, helps with free-tier rate limits
# HIRELENS_MAX_CRITIC_REVISIONS=2
# HIRELENS_MAX_ACTIVE_RUNS=3                 # concurrent analyses allowed on the server
# HIRELENS_REASONING_EFFORT=low                # for reasoning models such as openai/gpt-oss-120b on Groq
# HIRELENS_JSON_MODE=1                          # ask the provider for a guaranteed JSON reply
# HIRELENS_EXTRA_BODY={"reasoning_format":"hidden"}   # provider-specific options (JSON)
# HIRELENS_MAX_OUTPUT_TOKENS=900               # cap reply length (Groq free tier limits output tokens per minute)
